<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs one MIV poll every 5 minutes; poll.py stops itself on 2026-12-10. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>be.stimming.miv</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/tomvanderhegden/Library/Application Support/stimming-miv/poll.py</string>
    <string>/Users/tomvanderhegden/Library/Application Support/stimming-miv</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/tomvanderhegden/Library/Application Support/stimming-miv/poll.log</string>
  <key>StandardErrorPath</key><string>/Users/tomvanderhegden/Library/Application Support/stimming-miv/poll.log</string>
</dict>
</plist>
