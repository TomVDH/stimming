{
  "name": "stimming",
  "private": true,
  "description": "Dev tools and the TypeScript build. The site loads nothing from node_modules.",
  "type": "module",
  "scripts": {
    "dev": "node tools/build.mjs --dev",
    "build": "node tools/build.mjs",
    "check": "npm run check:shared && npm run check:railgun",
    "check:shared": "tsc --noEmit -p tsconfig.json",
    "check:railgun": "tsc --noEmit -p railgun/tsconfig.json"
  },
  "devDependencies": {
    "@types/culori": "4.0.1",
    "@types/three": "0.170.0",
    "esbuild": "0.25.10",
    "gsap": "3.13.0",
    "simplex-noise": "4.0.3",
    "tone": "15.0.4",
    "typescript": "6.0.3"
  }
}
